{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azul-travels",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Domínio de produção (zona no Cloudflare). `wrangler deploy` vincula o Worker a ele.
  "routes": [{ "pattern": "turismoazulinclusivo.com.br", "custom_domain": true }],
  // Chaves públicas do Supabase para o SSR (a publishable key não é secreta).
  "vars": {
    "SUPABASE_URL": "https://chksjpohnjfvshbwsuqo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_uFgePsqo39zmP8rkRQicGA_3PNFyIPi"
  }
}
